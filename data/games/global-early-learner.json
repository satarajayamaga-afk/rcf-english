    {
      "id": "weather-and-seasons",
      "title": "Weather and Seasons",
      "icon": "cloud.svg",
      "activities": [
        { "id": "gl-e-weather-match", "type": "match", "title": "Match the Weather", "instructions": "Tap a picture. Then tap its word.", "minutes": 3,
          "pairs": [ { "picture": "sun.svg", "word": "sunny" }, { "picture": "cloud.svg", "word": "cloudy" }, { "picture": "rain.svg", "word": "rainy" }, { "picture": "snowflake.svg", "word": "snowy" } ] },
        { "id": "gl-e-weather-quiz", "type": "quiz", "title": "What Is the Weather Like?", "instructions": "Look at the picture. Tap the right sentence.", "minutes": 3,
          "questions": [ { "picture": "sun.svg", "ask": "What is the weather like?", "options": ["It is sunny.", "It is snowy.", "It is rainy."], "answer": 0 }, { "picture": "snowflake.svg", "ask": "What is the weather like?", "options": ["It is hot.", "It is snowy.", "It is dry."], "answer": 1 }, { "picture": "rain.svg", "ask": "It is raining. What do you take?", "options": ["a kite", "sunglasses", "an umbrella"], "answer": 2 }, { "picture": "snowflake.svg", "ask": "It is snowing. What do you wear?", "options": ["a scarf", "a t-shirt", "sandals"], "answer": 0 } ] },
