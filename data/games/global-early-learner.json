    {
      "id": "my-home",
      "title": "My Home",
      "icon": "house.svg",
      "activities": [
        { "id": "gl-e-home-match", "type": "match", "title": "Match the Home Word", "instructions": "Tap a picture. Then tap its word.", "minutes": 3,
          "pairs": [ { "picture": "house.svg", "word": "house" }, { "picture": "door.svg", "word": "door" }, { "picture": "window.svg", "word": "window" }, { "picture": "roof.svg", "word": "roof" }, { "picture": "bed.svg", "word": "bed" }, { "picture": "table.svg", "word": "table" } ] },
        { "id": "gl-e-home-quiz", "type": "quiz", "title": "Where Is It?", "instructions": "Read the question. Tap the right answer.", "minutes": 3,
          "questions": [ { "picture": "bed.svg", "ask": "Where do you sleep?", "options": ["in a bed", "on a table", "in a bucket"], "answer": 0 }, { "picture": "door.svg", "ask": "What do you open to go in?", "options": ["a window", "a door", "a roof"], "answer": 1 }, { "picture": "chair.svg", "ask": "What do you sit on?", "options": ["a roof", "a door", "a chair"], "answer": 2 }, { "picture": "window.svg", "ask": "What do you look through?", "options": ["a window", "a bed", "a table"], "answer": 0 } ] },
        { "id": "gl-e-home-memory", "type": "memory", "title": "Home Pairs", "instructions": "Turn over two cards. Find a picture and its word.", "minutes": 4,
          "pairs": [ { "a": "bed.svg", "b": "bed" }, { "a": "door.svg", "b": "door" }, { "a": "window.svg", "b": "window" }, { "a": "table.svg", "b": "table" }, { "a": "chair.svg", "b": "chair" }, { "a": "lamp.svg", "b": "lamp" } ] }
      ]
    },
