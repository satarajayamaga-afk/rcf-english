          "buckets": [ { "id": "hot", "title": "Hot weather", "icon": "sun.svg" }, { "id": "cold", "title": "Cold weather", "icon": "snowflake.svg" } ],
          "items": [ { "text": "sun", "picture": "sun.svg", "bucket": "hot" }, { "text": "sunglasses", "picture": "sunglasses.svg", "bucket": "hot" }, { "text": "ice cream", "picture": "ice-cream.svg", "bucket": "hot" }, { "text": "snow", "picture": "snowflake.svg", "bucket": "cold" }, { "text": "scarf", "picture": "scarf.svg", "bucket": "cold" }, { "text": "tea", "picture": "tea.svg", "bucket": "cold" } ] }
      ]
