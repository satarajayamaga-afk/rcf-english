    { "id": "unit-3", "number": 3, "title": "Our School", "icon": "icon-notebook.svg",
      "outcomes": ["School and classroom words", "On Monday we have ...", "How much is a pen?", "Reading and role-play"], "topics": [] },
    { "id": "unit-4", "number": 4, "title": "My Food Bag", "icon": "icon-basket.svg",
