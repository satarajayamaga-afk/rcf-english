{
  "schemaVersion": 1,
  "grade": 4,
  "title": "Grade 4",
  "theme": "berry",
  "blurb": "Word classes, verbs and longer sentences.",
  "icon": "icon-target.svg",
  "book": {
    "title": "English Pupil's Book Grade 4",
    "publisher": "Educational Publications Department",
    "note": "Supplied 2026-09-02. 10 units. Unit titles and outcomes taken from the book itself."
  },
  "unitsStatus": "in-progress",
  "units": [
    { "id": "unit-1", "number": 1, "title": "My Family and Friends", "icon": "house.svg",
      "outcomes": ["Hello, how are you? / I'm fine", "I'm ... / I live in ...", "This is ... / These are ...", "He is ... / She is ...", "Parts of the body", "It has ..."], "topics": [] },
    { "id": "unit-2", "number": 2, "title": "Our Beautiful Garden", "icon": "flower.svg",
      "outcomes": ["Garden and plant words", "There is ... / There are ...", "Garden tools", "Listen and do: following instructions"], "topics": [] },
    { "id": "unit-3", "number": 3, "title": "Places Around Me", "icon": "bus.svg",
      "outcomes": ["Places in the town", "What's in picture ...?", "Directions: turn left, turn right", "Where do ...? / Where is ...?", "I go to ..."], "topics": [] },
    { "id": "unit-4", "number": 4, "title": "Joy of Work", "icon": "icon-gears.svg",
      "outcomes": ["Occupations and workplaces", "What do you do?", "Let's ...", "Giving instructions: Press ..., Select ..."], "topics": [] },
    { "id": "unit-5", "number": 5, "title": "Our Festivals", "icon": "balloon.svg",
      "outcomes": ["Festival names", "... is in (month)", "What are you doing? / Where are you going?", "I take ...", "Wishes and greeting cards"], "topics": [] },
    { "id": "unit-6", "number": 6, "title": "Let's Go Shopping", "icon": "icon-basket.svg",
      "outcomes": ["Shop words and prices", "This / These, That / Those", "Can I help you?", "How much is ...?", "How many ...?", "Question mark and full stop"], "topics": [] },
    { "id": "unit-7", "number": 7, "title": "My Calendar", "icon": "icon-numbers.svg",
      "outcomes": ["Days of the week", "Today is ...", "Months of the year", "before ... / after ...", "When is your birthday?", "Weather words", "Telling the time"], "topics": [] },
    { "id": "unit-8", "number": 8, "title": "Playing Games", "icon": "ball.svg",
      "outcomes": ["Action words: hop, skip, walk, run", "What can you do? / We can ...", "verb + ing: What are you doing?", "Hobbies and likes"], "topics": [] },
    { "id": "unit-9", "number": 9, "title": "Good Practices", "icon": "icon-sprout.svg",
      "outcomes": ["Good practices at school and at home", "May I ...? / Excuse me", "How are you? / How about you?", "I eat ... / I don't eat ...", "Let's plant and protect trees"], "topics": [] },
    { "id": "unit-10", "number": 10, "title": "Happy Days", "icon": "sun.svg",
      "outcomes": ["Feelings: hungry, thirsty, happy, sleepy, tired", "Are you ...? Yes / No", "Is this ...?", "Riddles: What is it?", "Inviting a friend", "Did you enjoy ...? / What did you do?"], "topics": [] }
  ],
  "topics": [
    {
      "id": "kinds-of-words",
      "title": "Kinds of Words",
      "icon": "icon-folders.svg",
      "activities": [
        {
          "id": "g4-word-class-sort",
          "type": "sort",
          "title": "Naming, Doing, Describing",
          "instructions": "Tap a word, then tap the right basket. You can drag them too.",
          "minutes": 5,
          "buckets": [
            { "id": "noun", "title": "Naming words" },
            { "id": "verb", "title": "Doing words" },
            { "id": "adj", "title": "Describing words" }
          ],
          "items": [
            { "text": "teacher", "bucket": "noun" },
            { "text": "village", "bucket": "noun" },
            { "text": "river", "bucket": "noun" },
            { "text": "jump", "bucket": "verb" },
            { "text": "write", "bucket": "verb" },
            { "text": "carry", "bucket": "verb" },
            { "text": "happy", "bucket": "adj" },
            { "text": "heavy", "bucket": "adj" },
            { "text": "bright", "bucket": "adj" }
          ]
        }
      ]
    },
    {
      "id": "verbs",
      "title": "Verbs at Work",
      "icon": "icon-gears.svg",
      "activities": [
        {
          "id": "g4-verbs-missing",
          "type": "missing",
          "title": "Choose the Right Verb",
          "instructions": "Tap the word that fits the sentence.",
          "minutes": 4,
          "items": [
            { "sentence": "My father ___ to work every morning.", "options": ["go", "goes", "going"], "answer": 1 },
            { "sentence": "The girls ___ singing in the hall.", "options": ["is", "was", "are"], "answer": 2 },
            { "sentence": "Yesterday we ___ to the market.", "options": ["walk", "walked", "walking"], "answer": 1 },
            { "sentence": "She ___ her homework before dinner.", "options": ["finish", "finishes", "finishing"], "answer": 1 },
            { "sentence": "The rain ___ heavily last night.", "options": ["fall", "falls", "fell"], "answer": 2 },
            { "sentence": "They ___ not seen that film.", "options": ["has", "have", "had been"], "answer": 1 }
          ]
        },
        {
          "id": "g4-opposites-quiz",
          "type": "quiz",
          "title": "Opposites Challenge",
          "instructions": "Choose the word that means the opposite.",
          "minutes": 4,
          "questions": [
            { "ask": "The opposite of heavy is...", "options": ["light", "hard", "tall"], "answer": 0 },
            { "ask": "The opposite of ancient is...", "options": ["old", "modern", "quiet"], "answer": 1 },
            { "ask": "The opposite of arrive is...", "options": ["reach", "enter", "leave"], "answer": 2 },
            { "ask": "The opposite of generous is...", "options": ["selfish", "kind", "gentle"], "answer": 0 },
            { "ask": "The opposite of shallow is...", "options": ["narrow", "deep", "wide"], "answer": 1 }
          ]
        }
      ]
    },
    {
      "id": "longer-sentences",
      "title": "Longer Sentences",
      "icon": "icon-puzzle.svg",
      "activities": [
        {
          "id": "g4-sentence-order",
          "type": "order",
          "title": "Rebuild the Sentence",
          "instructions": "Tap the words in order to rebuild the sentence.",
          "minutes": 4,
          "sentences": [
            { "words": ["The", "farmer", "carried", "a", "heavy", "basket"] },
            { "words": ["Our", "teacher", "reads", "a", "story", "every", "Friday"] },
            { "words": ["The", "bus", "stopped", "near", "the", "old", "bridge"] },
            { "words": ["My", "brother", "wants", "to", "become", "a", "doctor"] }
          ]
        }
      ]
    }
  ]
}
